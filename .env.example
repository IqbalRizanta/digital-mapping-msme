# ==========================================
# Peta Digital UMKM Kuliner Surabaya Timur
# Environment Configuration Template
# ==========================================

# Google Places API Key (WAJIB untuk Ingestion Data Online)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Kaggle API Credentials (Opsional jika menggunakan dataset Kaggle)
KAGGLE_USERNAME=
KAGGLE_KEY=

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=umkm-multimodal-digital-readiness

# Project Paths
RAW_DATA_PATH=data/raw
CLEAN_DATA_PATH=data/clean
GOLD_DATA_PATH=data/gold
MODELS_PATH=models

# Random Seed for Reproducibility
RANDOM_SEED=42
