  <mxCell id="a1" value="A. Dataset Gambar (Baru): 549 foto bersih (279.99 MB >= 200 MB) + 2.272 foto mentah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="80" as="geometry" /></mxCell>
  <mxCell id="a2" value="B. Dataset Teks &amp; Numerik (Baru): 385 UMKM Surabaya Timur + 1.164 ulasan asli (en/id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="40" width="260" height="80" as="geometry" /></mxCell>
  <mxCell id="a3" value="C. Dataset Dokumen (Baru): 3 PDF perizinan penelitian (pypdf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="260" height="80" as="geometry" /></mxCell>
  <mxCell id="a4" value="2. Preprocessing Multimodal &amp; PySpark Staging (OpenCLIP, OpenCV Blur, YOLOv8, Regex, pypdf, PySpark)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B26A00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="840" height="76" as="geometry" /></mxCell>
  <mxCell id="a5" value="3. Ekstraksi &amp; Fusi Fitur Multimodal (TF-IDF + Visual YOLO + Tabular + StandardScaler &amp; PCA -> Feature Store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="275" width="760" height="72" as="geometry" /></mxCell>
