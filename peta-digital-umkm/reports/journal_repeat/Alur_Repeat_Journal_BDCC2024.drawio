<mxGraphModel><root>
  <mxCell id="0" />
  <mxCell id="1" parent="0" />
  <mxCell id="r0" value="1. Data Acquisition (Kaggle Public Dataset)&lt;br&gt;Dataset-SA.csv — 205.052 baris x 6 kolom (Product, Price, Rate, Review, Summary, Sentiment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F4E79;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="760" height="72" as="geometry" /></mxCell>
  <mxCell id="r1" value="2. Data Cleaning — Hapus Missing Values (Section 3.1.4)&lt;br&gt;dropna() menghapus 24.664 null Review &amp; 11 null Summary -&gt; 180.379 baris (Neutral = 8.807)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F4E79;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="145" width="760" height="72" as="geometry" /></mxCell>
  <mxCell id="re1" edge="1" parent="1" source="r0" target="r1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
  <mxCell id="r2" value="3. Class Balancing untuk Menghilangkan Bias (Figure 5)&lt;br&gt;Eksperimen 1 ('Review'): 8.807 x 3 kelas = 26.421  |  Eksperimen 2 ('Summary'): 3.000 x 3 kelas = 9.000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="760" height="72" as="geometry" /></mxCell>
