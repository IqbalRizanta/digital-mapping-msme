  <mxCell id="r6" value="7. Evaluasi &amp; Verifikasi Hasil vs Tabel 2 &amp; 3 Jurnal&lt;br&gt;Review: RF 0.690 (Paper 0.680), SVM 0.690 (0.682), NB 0.457 (0.449)&lt;br&gt;Summary: RF 0.766 (Paper 0.767), SVM 0.754 (0.768), NB 0.452 (0.426)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="670" width="760" height="72" as="geometry" /></mxCell>
