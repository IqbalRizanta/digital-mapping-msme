# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.msme/
.venv/
venv/
env/
ENV/

# Secrets & Environment variables
.env
*.env
*.key
credentials.json
service-account*.json

# Ignore all Markdown files except root README.md
*.md
!README.md

# Raw & intermediate local data (synced to Google Drive)
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
data/gold/*
!data/gold/.gitkeep
data/staging_spark/*
!data/staging_spark/.gitkeep
data/*.zip
data/yolo/
data/yolo_cls/

# Base pretrained YOLO checkpoints
model/pretrained/*

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo
.ipynb_checkpoints/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
mlruns/
runs/

# Local duplicate workspace, sample scratch images, journal PDFs, and heavy legacy figure bundles
BDA-2026-Iqbal/
data/sample/
docs/Journal/*.pdf
docs/reports/figures/

